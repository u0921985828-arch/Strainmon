{
  "mcpServers": {
    "pixellab": {
      "type": "http",
      "url": "https://api.pixellab.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${PIXELLAB_TOKEN}"
      }
    },
    "pixellab-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "pixellab-mcp"
      ],
      "env": {
        "PIXELLAB_SECRET": "${PIXELLAB_SECRET}"
      }
    }
  }
}
