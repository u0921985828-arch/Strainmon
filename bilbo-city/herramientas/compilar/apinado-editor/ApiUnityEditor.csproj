<Project Sdk="Microsoft.NET.Sdk">
  <!-- Remedo de UnityEditor. En ensamblado aparte a propósito: así el proyecto
       de runtime no puede ver el editor, igual que en Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>ApiUnityEditor</AssemblyName>
    <RootNamespace>UnityEditor</RootNamespace>
    <Nullable>disable</Nullable>
    <NoWarn>CS0169;CS0649;CS0067;CS0660;CS0661;CS0108;CS0114;CS8981;CS0282</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Api/**/*.cs" />
    <ProjectReference Include="../apinado/ApiUnity.csproj" />
  </ItemGroup>
</Project>
