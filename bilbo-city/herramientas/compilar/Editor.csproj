<Project Sdk="Microsoft.NET.Sdk">
  <!-- Assets/Editor. Solo aquí se ve UnityEditor y solo aquí vale UNITY_EDITOR:
       si un fichero de runtime tocara el editor, el otro proyecto lo caza. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>BilboCity.Editor</AssemblyName>
    <RootNamespace>BilboCity</RootNamespace>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);UNITY_2022_3_OR_NEWER;UNITY_2022_3;UNITY_EDITOR</DefineConstants>
    <NoWarn>CS0649</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/BilboCity/Assets/Editor/**/*.cs" />
    <ProjectReference Include="Juego.csproj" />
    <ProjectReference Include="apinado/ApiUnity.csproj" />
    <ProjectReference Include="apinado-editor/ApiUnityEditor.csproj" />
  </ItemGroup>
</Project>
